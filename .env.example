# =====================================================================
# Maison Aurore — variáveis de ambiente (MODELO)
# =====================================================================
# Este arquivo é só um modelo, sem valores reais, e PODE ir para o Git.
#
# Como usar:
#   1. Copie este arquivo para ".env"  →  cp .env.example .env
#   2. Preencha os valores no ".env".
#   O ".env" está no .gitignore e NUNCA deve ir para o Git.
#
# REGRAS DE SEGURANÇA
#   • Variáveis com prefixo VITE_ são embutidas no site e qualquer pessoa
#     consegue lê-las no navegador. NUNCA coloque token ou chave com VITE_.
#   • Tokens e chaves ficam só no back-end (Cloudflare Worker), sem VITE_.
#   • Em produção os segredos não usam arquivo: cadastre cada um com
#       npx wrangler secret put NOME_DA_VARIAVEL
#   • Se um token vazar (commit, print, chat), revogue e gere outro na hora.
# =====================================================================


# ---------------------------------------------------------------------
# FRONT-END (público: vai para o navegador)
# ---------------------------------------------------------------------

# Endereço da API de IA (o Worker). Vazio = mesma origem do site ("/api").
VITE_AI_API_URL=


# ---------------------------------------------------------------------
# BACK-END / WORKER (SECRETO: nunca com prefixo VITE_)
# ---------------------------------------------------------------------

# Hugging Face: provador virtual (Space público via @gradio/client).
# Opcional, mas recomendado: com token, a fila e a cota gratuita de GPU melhoram.
# Onde obter: huggingface.co → Settings → Access Tokens → New token (tipo "Read").
HF_TOKEN=

# Cloudflare Workers AI: geração de imagens (@cf/black-forest-labs/flux-1-schnell).
# Dentro do Worker, o acesso é pelo binding "AI" do wrangler e NÃO precisa de token.
# Preencha só se for chamar a API REST de fora do Worker (por exemplo, num script).
# Onde obter: dash.cloudflare.com → My Profile → API Tokens → modelo "Workers AI".
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=


# ---------------------------------------------------------------------
# CONFIGURAÇÃO DO WORKER (não secreta)
# ---------------------------------------------------------------------

# Space do provador. Confirmar com view_api antes de usar: nomes e parâmetros mudam.
TRYON_SPACE=yisol/IDM-VTON

# Origens que podem chamar a API, separadas por vírgula.
ALLOWED_ORIGINS=http://localhost:5173

# Rate limit por IP, para proteger a cota gratuita: no máximo N pedidos por janela.
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_SECONDS=60

# Tempo máximo de espera, em milissegundos, antes de mostrar a imagem de exemplo.
IMAGE_TIMEOUT_MS=20000
TRYON_TIMEOUT_MS=120000
