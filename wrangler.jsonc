{
  // Cloudflare Worker da Maison Aurore: serve o site (dist/) e a API de IA (/api/*).
  // Chaves secretas NÃO ficam aqui: local → .env (fora do Git); produção → `npx wrangler secret put`.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "maison-aurore",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],

  // Site estático: rotas desconhecidas caem no index.html (SPA); /api/* vai direto para o Worker.
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },

  // Workers AI (geração de imagens). Acesso pelo vínculo: não precisa de token.
  "ai": { "binding": "AI", "remote": true },

  // Fotos geradas (por hash) e pedidos sob medida. Crie com `npx wrangler kv namespace create CACHE`
  // e cole o id abaixo antes do primeiro deploy (em desenvolvimento local, qualquer id funciona).
  "kv_namespaces": [{ "binding": "CACHE", "id": "cole-aqui-o-id-do-kv" }],

  // Rate limit por IP (janela de 60s; aproximado por região): protege a cota gratuita
  // de imagens, os pedidos contra spam e a senha do painel contra tentativas.
  "ratelimits": [
    { "name": "LIMITE_IMAGEM", "namespace_id": "4101", "simple": { "limit": 5, "period": 60 } },
    { "name": "LIMITE_PEDIDO", "namespace_id": "4103", "simple": { "limit": 3, "period": 60 } },
    { "name": "LIMITE_PAINEL", "namespace_id": "4104", "simple": { "limit": 10, "period": 60 } },
  ],

  // Configuração não secreta (pode ser sobrescrita pelo .env em desenvolvimento).
  "vars": {
    "ALLOWED_ORIGINS": "http://localhost:5173",
    "IMAGE_TIMEOUT_MS": "20000",
  },

  "observability": { "enabled": true },
}
