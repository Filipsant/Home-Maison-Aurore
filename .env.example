# =====================================================================
# Maison Aurore — variáveis de ambiente (MODELO)
# =====================================================================
# Este arquivo é só um modelo, sem valores reais, e PODE ir para o Git.
#
# Como usar:
#   1. Copie este arquivo para ".env"  →  cp .env.example .env
#   2. Preencha os valores no ".env".
#   O ".env" está no .gitignore e NUNCA deve ir para o Git.
#   O Worker lê o ".env" em desenvolvimento (fica ao lado do wrangler.jsonc).
#
# REGRAS DE SEGURANÇA
#   • Variáveis com prefixo VITE_ são embutidas no site e qualquer pessoa
#     consegue lê-las no navegador. NUNCA coloque token ou chave com VITE_.
#   • Tokens e chaves ficam só no back-end (Cloudflare Worker), sem VITE_.
#   • Em produção os segredos não usam arquivo: cadastre cada um com
#       npx wrangler secret put HF_TOKEN
#   • Se um token vazar (commit, print, chat), revogue e gere outro na hora.
# =====================================================================


# ---------------------------------------------------------------------
# FRONT-END (público: vai para o navegador)
# ---------------------------------------------------------------------

# Endereço da API de IA. Vazio = mesma origem do site ("/api"), que é o padrão.
VITE_AI_API_URL=


# ---------------------------------------------------------------------
# WORKER (SECRETO: nunca com prefixo VITE_)
# ---------------------------------------------------------------------

# Hugging Face: provador virtual. Opcional, mas recomendado: com token, a cota
# gratuita de GPU (ZeroGPU) é maior e a fila anda mais rápido.
# Onde obter: huggingface.co → Settings → Access Tokens → New token (tipo "Read").
HF_TOKEN=


# ---------------------------------------------------------------------
# CLOUDFLARE (só no seu computador; nunca vão para o deploy)
# ---------------------------------------------------------------------
# 1) Com as duas preenchidas, `npm run dev` já gera imagens de verdade: o Worker
#    local chama o Workers AI pela API REST com este token. Basta a permissão
#    "Workers AI" (ler e editar) — é o modelo "Workers AI" do painel.
#    Em produção o .env não é enviado e o Worker usa o vínculo AI, sem token.
#    NÃO cadastre este token com `wrangler secret put`.
# 2) O wrangler também usa as duas em `npm run dev:ia` e `npm run deploy`; aí o
#    token precisa do modelo "Edit Cloudflare Workers" MAIS "Workers AI: Edit".
#    Alternativa para o deploy: deixe-as vazias e rode `npx wrangler login`.
# Onde obter: dash.cloudflare.com → My Profile → API Tokens.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=


# ---------------------------------------------------------------------
# CONFIGURAÇÃO DO WORKER (não secreta; padrões no wrangler.jsonc)
# ---------------------------------------------------------------------
# Os limites por IP (5 imagens e 2 provas por minuto) ficam em "ratelimits"
# no wrangler.jsonc.

# Spaces do provador: principal e reserva (mesma API, conferida com view_api).
TRYON_SPACE=yisol/IDM-VTON
TRYON_SPACE_RESERVA=Nymbo/Virtual-Try-On

# Origens de outros domínios que podem chamar a API, separadas por vírgula.
# O próprio site (mesma origem) é sempre aceito.
ALLOWED_ORIGINS=http://localhost:5173

# Tempo máximo de espera, em milissegundos, antes de mostrar a imagem de exemplo.
IMAGE_TIMEOUT_MS=20000
TRYON_TIMEOUT_MS=120000
